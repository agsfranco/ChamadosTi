{
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "jquery@4.0.0",
      "destination": "lib/jquery"
    },
    {
      "library": "jquery-validation-unobtrusive@4.0.0",
      "destination": "lib/jquery-validation-unobtrusive"
    },
    {
      "library": "bootstrap@5.3.8",
      "destination": "lib/bootstrap"
    },
    {
      "library": "jquery-validate@1.22.1",
      "destination": "lib/jquery-validate"
    },
    {
      "provider": "unpkg",
      "library": "bootstrap-icons@1.11.3",
      "destination": "./lib/bootstrap-icons",
      "files": [
        "font/bootstrap-icons.min.css",
        "font/fonts/bootstrap-icons.woff",
        "font/fonts/bootstrap-icons.woff2"
      ]
    },
    {
      "library": "Chart.js@4.5.1",
      "destination": "lib/Chart_js"
    }
  ]
}