@model ChamadosTi.ViewModels.Setor.SetorViewModel
@{ ViewData["Title"] = Localizer["Setores_Create_Title"]; }

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="border rounded p-4 shadow-sm bg-white">
            <h2 class="h3 mb-3 fw-normal text-center">@ViewData["Title"]</h2>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="form-floating mb-3">
                    <input asp-for="Nome" class="form-control" placeholder="Nome" aria-required="true" />
                    <label asp-for="Nome">@Localizer["Label_Nome"]</label>
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>
                <div class="form-floating mb-4">
                    <textarea asp-for="Descricao" class="form-control" placeholder="Descrição" style="height: 100px;"></textarea>
                    <label asp-for="Descricao">@Localizer["Label_Descricao"]</label>
                </div>
                <div class="form-check form-switch mb-4">
                    <input asp-for="Ti" type="checkbox" class="form-check-input" role="switch" id="Ti" />
                    <label asp-for="Ti" class="form-check-label" for="Ti">@Localizer["Ti"]</label>
                    <span asp-validation-for="Ti" class="text-danger small d-block"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">@Localizer["Button_Save"]</button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">@Localizer["Button_Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
