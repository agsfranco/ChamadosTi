@model IEnumerable<ChamadosTi.Models.Setor>
@{ ViewData["Title"] = Localizer["Setores_Index_Title"]; }

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Button_NewSetor"]</a>
</div>

<!-- Filtro de Ativos / Inativos Corrigido -->
<div class="mb-4">
    <form asp-action="Index" method="get" class="d-inline-block">
        <!-- Alterado para form-check form-switch e adicionado ps-5 para recuar o texto -->
        <div class="form-check form-switch bg-white border rounded py-2 pe-3 ps-5 shadow-sm d-inline-flex align-items-center">
            <input class="form-check-input" type="checkbox" id="chkExibirInativos" name="exibirInativos" value="true"
                   @(ViewBag.ExibirInativos ? "checked" : "") onchange="this.form.submit()" style="cursor: pointer;" />
            <label class="form-check-label text-secondary fw-medium ms-2" for="chkExibirInativos" style="cursor: pointer;">
                @Localizer["Checkbox_ShowDeactivated"]
            </label>
        </div>
    </form>
</div>


<div class="card shadow-sm bg-white rounded border">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="px-4">@Localizer["Table_Nome"]</th>
                    <th scope="col">@Localizer["Table_Descricao"]</th>                    
                    <th scope="col" class="text-center">@Localizer["Table_Ti"]</th>
                    <th scope="col" class="text-end px-4">@Localizer["Table_Acoes"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">@Localizer["No_Records_Found"]</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="@(!item.Ativo ? "table-light text-muted opacity-75" : "")">
                        <td class="fw-medium px-4">
                            @item.Nome
                            @if (!item.Ativo)
                            {
                                <span class="badge bg-secondary text-white ms-2 small">@Localizer["Badge_Deactivated"]</span>
                            }
                        </td>
                        <td>@item.Descricao</td>
                        <td class="text-center">
                            @if (item.Ti)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill fw-semibold">
                                    <i class="bi bi-check-circle-fill me-1"></i> @Localizer["Text_Sim"]
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-secondary border px-2.5 py-1.5 rounded-pill">
                                    <i class="bi bi-dash-circle me-1"></i> @Localizer["Text_Nao"]
                                </span>
                            }
                        </td>
                        <td class="text-end px-4">
                            @if (item.Ativo)
                            {
                                <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1">@Localizer["Button_Edit"]</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">@Localizer["Button_Delete"]</a>
                            }
                            else
                            {
                                <form asp-action="Ativar" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bi bi-arrow-counterclockwise"></i> @Localizer["Button_Activate"]
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
