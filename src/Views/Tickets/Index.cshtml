@model IEnumerable<ChamadosTi.Models.Ticket>
@{ ViewData["Title"] = Localizer["Tickets_Index_Title"]; }

<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Button_NewTicket"]</a>
</div>

<div class="card shadow-sm bg-white rounded border">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="px-4">@Localizer["Table_Ticket"]</th>
                    <th scope="col">@Localizer["Table_Solicitante"]</th>
                    <th scope="col">@Localizer["Table_Status"]</th>
                    <th scope="col">@Localizer["Table_DataAbertura"]</th>
                    <th scope="col">@Localizer["Table_PrazoSLA"]</th>
                    <th scope="col" class="text-end px-4">@Localizer["Table_Acoes"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">@Localizer["No_Tickets_Found"]</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                    <td class="px-4">
                        <div class="fw-bold text-dark">#@item.Id - @item.Titulo</div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                            <span class="text-muted small">@item.Categorias.Nome (@item.Prioridades.Nome)</span>
                            @if (item.TicketOrigemId != null)
                            {
                                <a asp-action="Details" asp-route-id="@item.TicketOrigemId" 
                                class="badge bg-light text-secondary border border-secondary-subtle text-decoration-none py-1 px-2 small shadow-sm opacity-85"
                                title="@Localizer["Tickets_Index_TooltipOrigem"]" style="font-size: 0.75rem;">
                                    <i class="bi bi-link-45deg"></i> #@item.TicketOrigemId
                                </a>
                            }
                        </div>
                    </td>

                        <td class="fw-medium text-secondary">@item.Usuarios.Nome</td>
                        <td>
                            @{
                                // Define a classe de cor do Bootstrap com base no código do status
                                string classeCorStatus = item.Status.Codigo switch
                                {
                                    1 => "bg-info",          // Aberto (Azul claro / Ciano)
                                    2 => "bg-primary",       // Em Atendimento (Azul sólido)
                                    3 => "bg-warning text-dark", // Pendente (Amarelo de atenção)
                                    4 => "bg-success",       // Resolvido (Verde de sucesso)
                                    _ => "bg-secondary"      // Qualquer outro ou Fechado (Cinza)
                                };
                            }
                            <span class="badge @classeCorStatus fw-bold px-3 py-2 fs-7 shadow-sm">
                                @Localizer[item.Status.Nome]
                            </span>
                        </td>
                        <td class="text-secondary small">@item.DataAbertura.ToLocalTime().ToString("g")</td>
                        <td>
                            @{
                                var agoraUtc = DateTime.UtcNow;
                                var prazoUtc = item.PrazoResolucaoSLA;
                                
                                TimeSpan tempoRestante = prazoUtc - agoraUtc;

                                string classeCorSla = "text-secondary"; // Padrão neutro para chamados dentro do prazo seguro
                                string iconeSla = "bi-clock";           // Ícone padrão de relógio
                                string tituloTooltip = Localizer["Tickets_Index_SlaNoPrazo"].Value;

                                if (tempoRestante.TotalMinutes < 0)
                                {
                                    // CRÍTICO: O prazo já estourou!
                                    classeCorSla = "text-danger fw-bold";
                                    iconeSla = "bi-exclamation-octagon-fill";
                                    tituloTooltip = Localizer["Tickets_Index_SlaVencido"].Value;
                                }
                                else if (tempoRestante.TotalDays <= 1)
                                {
                                    // ATENÇÃO: Falta menos de 24 horas (1 dia) para vencer
                                    classeCorSla = "text-warning fw-bold";
                                    iconeSla = "bi-exclamation-triangle-fill";
                                    tituloTooltip = Localizer["Tickets_Index_SlaAlerta"].Value;
                                }
                            }
                            <div class="@classeCorSla small d-inline-flex align-items-center gap-1" title="@tituloTooltip">
                                <i class="bi @iconeSla"></i>
                                <span>@item.PrazoResolucaoSLA.ToLocalTime().ToString("g")</span>
                            </div>
                        </td>
                        <td class="text-end px-4">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i> @Localizer["Button_Details"]
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
