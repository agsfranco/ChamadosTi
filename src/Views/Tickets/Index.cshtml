@model IEnumerable<ChamadosTi.Models.Ticket>
@{ ViewData["Title"] = Localizer["Tickets_Index_Title"]; }

<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Button_NewTicket"]</a>
</div>

<div class="card shadow-sm bg-white rounded border">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="px-4">@Localizer["Table_Ticket"]</th>
                    <th scope="col">@Localizer["Table_Solicitante"]</th>
                    <th scope="col">@Localizer["Table_Status"]</th>
                    <th scope="col">@Localizer["Table_DataAbertura"]</th>
                    <th scope="col">@Localizer["Table_PrazoSLA"]</th>
                    <th scope="col" class="text-end px-4">@Localizer["Table_Acoes"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">@Localizer["No_Tickets_Found"]</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="px-4">
                            <div class="fw-bold text-dark">#@item.Id - @item.Titulo</div>
                            <span class="text-muted small">@item.Categorias.Nome (@item.Prioridades.Nome)</span>
                        </td>
                        <td class="fw-medium text-secondary">@item.Usuarios.Nome</td>
                        <td>
                            @{
                                // Define a classe de cor do Bootstrap com base no código do status
                                string classeCorStatus = item.Status.Codigo switch
                                {
                                    1 => "bg-info",          // Aberto (Azul claro / Ciano)
                                    2 => "bg-primary",       // Em Atendimento (Azul sólido)
                                    3 => "bg-warning text-dark", // Pendente (Amarelo de atenção)
                                    4 => "bg-success",       // Resolvido (Verde de sucesso)
                                    _ => "bg-secondary"      // Qualquer outro ou Fechado (Cinza)
                                };
                            }
                            <!-- Renderiza o badge com a cor dinâmica e o texto internacionalizado -->
                            <span class="badge @classeCorStatus fw-bold px-3 py-2 fs-7 shadow-sm">
                                @Localizer[item.Status.Nome]
                            </span>
                        </td>
                        <td class="text-secondary small">@item.DataAbertura.ToLocalTime().ToString("g")</td>
                        <td>
                            <!-- Exibe o prazo limite convertido para o horário local -->
                            <div class="fw-medium text-danger small">
                                <i class="bi bi-clock-history"></i> @item.PrazoResolucaoSLA.ToLocalTime().ToString("g")
                            </div>
                        </td>
                        <td class="text-end px-4">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i> @Localizer["Button_Details"]
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
