@namespace ChamadosTi.Views.Tickets
@model IEnumerable<ChamadosTi.Models.Ticket>
@{ ViewData["Title"] = Localizer["Tickets_Index_Title"]; }

<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Button_NewTicket"]</a>
</div>

@if (ViewBag.EhTecnico)
{
    <div class="mb-4">
        <form asp-action="Index" method="get" class="d-inline-block">
            <div class="form-check form-switch bg-white border rounded py-2 pe-3 ps-5 shadow-sm d-inline-flex align-items-center">
                <input class="form-check-input" type="checkbox" id="chkExibirTodos" name="exibirTodos" value="true"
                       @(ViewBag.ExibirTodos ? "checked" : "") onchange="this.form.submit()" style="cursor: pointer;" />
                <label class="form-check-label text-secondary fw-medium ms-2" for="chkExibirTodos" style="cursor: pointer;">
                    @Localizer["Checkbox_ShowAllTickets"]
                </label>
            </div>
        </form>
    </div>
}

<div class="card shadow-sm bg-white rounded border">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="px-4">@Localizer["Table_Ticket"]</th>
                    <th scope="col">@Localizer["Table_Solicitante"]</th>
                    <th scope="col">@Localizer["Table_Status"]</th>
                    <th scope="col">@Localizer["Table_DataAbertura"]</th>
                    <th scope="col">@Localizer["Table_PrazoSLA"]</th>
                    <th scope="col" class="text-end px-4">@Localizer["Table_Acoes"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">@Localizer["No_Tickets_Found"]</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="px-4">
                            <div class="fw-bold text-dark">#@item.Id - @item.Titulo</div>
                            <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                                <span class="text-muted small">@item.Categorias.Nome (@item.Prioridades.Nome)</span>
                                @if (item.TicketOrigemId != null)
                                {
                                    <a asp-action="Details" asp-route-id="@item.TicketOrigemId" 
                                       class="badge bg-light text-secondary border border-secondary-subtle text-decoration-none py-1 px-2 small shadow-sm opacity-85"
                                       title="@Localizer["Tickets_Index_TooltipOrigem"]" style="font-size: 0.75rem;">
                                        <i class="bi bi-link-45deg"></i> #@item.TicketOrigemId
                                    </a>
                                }
                            </div>
                        </td>

                        <td class="fw-medium text-secondary">@item.Usuarios.Nome</td>
                        <td>
                            @{
                                string classeCorStatus = item.Status.Codigo switch
                                {
                                    1 => "bg-info",          
                                    2 => "bg-primary",       
                                    3 => "bg-warning text-dark", 
                                    4 => "bg-success",       
                                    _ => "bg-secondary"      
                                };
                            }
                            <span class="badge @classeCorStatus fw-bold px-3 py-2 fs-7 shadow-sm">
                                @Localizer[item.Status.Nome]
                            </span>
                        </td>
                        
                        <!-- Coluna Data de Abertura + SLA de Resposta Condicional -->
                        <td class="text-secondary small">
                            @{
                                var agoraUtc = DateTime.UtcNow;
                                string classeCorSlaResp = "text-secondary";
                                string iconeSlaResp = "bi-chat-left-dots";
                                bool abertoSemTecnico = item.Status.Codigo < (int)TicketStatus.Resolvido && item.UsuarioTecnicoId == null;

                                // Só calcula alerta de resposta se o chamado estiver ativo E sem técnico
                                if (abertoSemTecnico)
                                {
                                    TimeSpan restResposta = item.PrazoRespostaSLA - agoraUtc;
                                    if (restResposta.TotalMinutes < 0) { classeCorSlaResp = "text-danger fw-bold"; iconeSlaResp = "bi-exclamation-octagon-fill"; }
                                    else if (restResposta.TotalDays <= 1) { classeCorSlaResp = "text-warning fw-bold"; iconeSlaResp = "bi-exclamation-triangle-fill"; }
                                }
                            }
                            <div><i class="bi bi-calendar-plus text-muted me-1"></i>@item.DataAbertura.ToLocalTime().ToString("g")</div>
                            @if (abertoSemTecnico)
                            {
                                <div class="@classeCorSlaResp mt-1" style="font-size: 0.72rem;">
                                    <i class="bi @iconeSlaResp"></i> Resp: @item.PrazoRespostaSLA.ToLocalTime().ToString("g")
                                </div>
                            }
                        </td>
                        
                        <!-- Coluna PrazoResolucaoSLA -->
                        <td>
                            @{
                                string classeCorSlaReso = "text-secondary"; 
                                string iconeSlaReso = "bi-clock";           
                                string tituloTooltip = Localizer["Tickets_Index_SlaNoPrazo"].Value;

                                if (item.Status.Codigo < (int)TicketStatus.Resolvido)
                                {
                                    TimeSpan restResolucao = item.PrazoResolucaoSLA - agoraUtc;
                                    if (restResolucao.TotalMinutes < 0)
                                    {
                                        classeCorSlaReso = "text-danger fw-bold";
                                        iconeSlaReso = "bi-exclamation-octagon-fill";
                                        tituloTooltip = Localizer["Tickets_Index_SlaVencido"].Value;
                                    }
                                    else if (restResolucao.TotalDays <= 1)
                                    {
                                        classeCorSlaReso = "text-warning fw-bold";
                                        iconeSlaReso = "bi-exclamation-triangle-fill";
                                        tituloTooltip = Localizer["Tickets_Index_SlaAlerta"].Value;
                                    }
                                }
                            }
                            <div class="@classeCorSlaReso small d-inline-flex align-items-center gap-1" title="@tituloTooltip">
                                <i class="bi @iconeSlaReso"></i>
                                <span>@item.PrazoResolucaoSLA.ToLocalTime().ToString("g")</span>
                            </div>
                        </td>
                        
                        <td class="text-end px-4">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i> @Localizer["Button_Details"]
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>