@model ChamadosTi.Models.Ticket
@{
    ViewData["Title"] = Localizer["Details_TituloPagina"].Value + " #" + Model.Id;

    var logsDecodificados = ViewBag.LogsHistorico as List<ChamadosTi.Models.LogAuditoriaTicket>;
    var auditoriasOriginais = ViewBag.AuditoriasOriginais as List<ChamadosTi.Models.AuditoriaTicket>;

    string classeCorStatusDetails = Model.Status.Codigo switch
    {
        1 => "bg-info",
        2 => "bg-primary",
        3 => "bg-warning text-dark",
        4 => "bg-success",
        6 => "bg-danger",
        _ => "bg-secondary"
    };
}

@{
    //ViewModel Cancelar
    var modelCancelar= new ModalMessageViewModel
    {
        Tipo = TipoModal.Error,
        ModalId = "modalCancelarTicket",
        Titulo = Localizer["Details_ModalCancelarTitulo"].Value,
        Mensagem = Localizer["Details_ModalCancelarInstrucao"].Value,

        Controller = "Tickets",
        Action = "Cancelar",
        RouteId = Model.Id.ToString(),
        Method = "post",

        BotaoAbrirHabilitado = true,
        BotaoAbrirTexto = Localizer["Details_BotaoCancelar"].Value,

        Botao = TipoBotaoModal.ConfirmarCancelar,
        BotaoConfirmarType = "submit" 
    };

    //ViewModel Concluir
    var modelConcluir = new ModalMessageViewModel
    {
        Tipo = TipoModal.Success,
        ModalId = "modalConcluirTicket",
        Titulo = Localizer["Details_ModalParecerTecnicoTitulo"].Value,
        Mensagem = Localizer["Details_ModalParecerTecnicoInstrucao"].Value,
        
        Controller = "Tickets",
        Action = "MoverParaResolvido",
        RouteId = Model.Id.ToString(),
        Method = "post",

        BotaoAbrirHabilitado = true,
        BotaoAbrirTexto = Localizer["Details_BotaoResolvido"].Value,

        Botao = TipoBotaoModal.ConfirmarCancelar,
        BotaoConfirmarType = "submit" 
    };

     //Botão Assumir
    Func<object?, HelperResult> RenderizarBotaoAssumir = @<form asp-action="Assumir" asp-route-id="@Model.Id" method="post" class="mt-2">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-sm btn-success w-100 shadow-sm fw-semibold py-2">
            <i class="bi bi-hand-index-thumb-fill"></i> @Localizer["Details_BotaoAssumir"]
        </button>
    </form>;

    //Botão Pendente
    Func<object?, HelperResult> RenderizarBotaoPendente = @<text>
        <div class="d-flex gap-2 mt-2">
            <form asp-action="MoverParaPendente" asp-route-id="@Model.Id" method="post" class="w-100">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-warning text-warning-emphasis w-100 shadow-sm fw-semibold py-2">
                    <i class="bi bi-pause-fill"></i> @Localizer["Details_BotaoPendente"]
                </button>
            </form>
        </div>
    </text>;

    //Botão Retomar
    Func<object?, HelperResult> RenderizarBotaoRetomar = @<text>
        <div class="d-flex gap-2 mt-2 mb-3">
            <form asp-action="RetomarAtendimento" asp-route-id="@Model.Id" method="post" class="w-100">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-primary w-100 shadow-sm fw-semibold py-2">
                    <i class="bi bi-play-fill"></i> @Localizer["Details_BotaoRetomar"]
                </button>
            </form>
        </div>
    </text>; 

    //Link AbrirNovo
    Func<object?, HelperResult> RenderizarLinkAbrirNovo = @<text>
        <div class="mt-4 pt-3 border-top">
            <label class="text-muted small d-block mb-2">@Localizer["Details_LabelAcoesEncerradas"]</label>
            <a asp-action="Create" asp-route-origemId="@Model.Id" class="btn btn-sm btn-outline-primary w-100 shadow-sm fw-semibold py-2">
                <i class="bi bi-box-arrow-up-right"></i> @Localizer["Details_BotaoGerarVinculado"]
            </a>
        </div>
    </text>;


    //Alteração de Ativos Afetados
    Func<object?, HelperResult> RenderizarFormularioAlterarItens = @<text>
        @if (ViewBag.Itens != null && ((System.Collections.IEnumerable)ViewBag.Itens).Cast<object>().Any())
        {
            <div class="card shadow-sm border rounded bg-white p-4 mt-4">
                <h5 class="card-title fw-bold text-secondary mb-3">@Localizer["Details_SecaoAlterarAtivos"]</h5>
                <form asp-action="AlterarItens" asp-controller="Tickets" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ticketId" value="@Model.Id" />
                    
                    <div class="mb-3">
                        <label class="text-muted small fw-medium mb-1">@Localizer["Details_LabelSelecaoAtivos"]</label>
                        <select name="itensIdsSelecionados" class="form-select form-select-sm small text-dark" multiple style="height: 110px;"
                                asp-items="@(new SelectList(ViewBag.Itens, "Id", "Texto", Model.ItensTickets?.Select(it => it.ItemId)))">
                        </select>
                        <span class="text-muted small d-block mt-1 lh-sm" style="font-size: 0.72rem;">
                            <i class="bi bi-info-circle"></i> @Localizer["Details_DicaSelecaoMultipla"]
                        </span>
                    </div>
                    
                    <div class="text-end">
                        <button type="submit" class="btn btn-sm btn-outline-primary px-4 shadow-sm fw-semibold">
                            <i class="bi bi-hdd-rack-fill me-1"></i> @Localizer["Details_BotaoSalvarAtivos"]
                        </button>
                    </div>
                </form>
            </div>
        }
    </text>;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small shadow-sm mt-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small shadow-sm mt-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mt-4 mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">
        <i class="bi bi-arrow-left"></i> @Localizer["Details_BotaoVoltar"]
    </a>

    @if (Model.TicketOrigemId != null)
    {
        <div class="mb-3">
            <a asp-action="Details" asp-route-id="@Model.TicketOrigemId" class="badge bg-light text-primary border border-primary-subtle text-decoration-none p-2 fs-7 shadow-sm">
                <i class="bi bi-link-45deg"></i> @Localizer["Details_LinkTicketOrigem"] #@Model.TicketOrigemId
            </a>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center">
        <h2>#@Model.Id - @Model.Titulo</h2>
        <span class="badge @classeCorStatusDetails fs-6 px-3 py-2">@Localizer[Model.Status.Nome]</span>
    </div>
    <span class="text-muted small">@Model.Categorias.Nome • @Model.Setores.Nome</span>
</div>

<div class="row">
    <!-- COLUNA DA ESQUERDA: Informações Principais, Inventário e Timeline -->
    <div class="col-lg-8 mb-4">
        <div class="card shadow-sm border rounded bg-white p-4 mb-4">
            <h5 class="card-title fw-bold text-secondary mb-3">@Localizer["Details_SecaoDescricao"]</h5>
            <p class="card-text text-dark" style="white-space: pre-line;">@Model.Comentario</p>
        </div>

        <div class="card shadow-sm border rounded bg-white p-4 mb-4">
            <h5 class="card-title fw-bold text-secondary mb-3">@Localizer["Details_SecaoAtivos"]</h5>
            @if (Model.ItensTickets != null && Model.ItensTickets.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">@Localizer["Details_TabelaAtivo"]</th>
                                <th scope="col">@Localizer["Details_TabelaTipo"]</th>
                                <th scope="col">@Localizer["Details_TabelaMarca"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var itemTicket in Model.ItensTickets)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@itemTicket.Item.Nome</td>
                                    <td class="text-secondary">@itemTicket.Item.Tipos.Nome</td>
                                    <td class="text-secondary">@itemTicket.Item.Marcas.Nome</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small mb-0"><i class="bi bi-info-circle"></i> @Localizer["Details_SemAtivos"]</p>
            }

            @if (Model.Status.Codigo < (int)TicketStatus.Resolvido)
            {
                @RenderizarFormularioAlterarItens(null)
            }
        </div>
        
        <!-- Card de histórico do Ativo -->
        <div class="card shadow-sm border rounded bg-white p-4 mb-4">
            <h5 class="card-title fw-bold text-secondary mb-3">@Localizer["Title_HistoricoEquipamento"]</h5>
            
            @{
                var historicoIncidentes = ViewBag.HistoricoAtivo as List<TicketHistoricoAtivoDTO>;
                bool possuiMultiplosAtivos = Model.ItensTickets != null && Model.ItensTickets.Count > 1;
            }

            @if (Model.ItensTickets != null && Model.ItensTickets.Any() && historicoIncidentes != null && historicoIncidentes.Any())
            {
                @if (possuiMultiplosAtivos)
                {
                    <!-- Abas do Bootstrap para Filtro de Ativos -->
                    <ul class="nav nav-tabs mb-3 small" id="filtroHistoricoTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-bold text-primary" onclick="filtrarHistoricoPorAtivo('todos', this)" type="button">
                                <i class="bi bi-layers-fill me-1"></i> @Localizer["Filter_TodosOsAtivos"]
                            </button>
                        </li>
                        @foreach (var itemTicket in Model.ItensTickets)
                        {
                            <li class="nav-item" role="presentation">
                                <button class="nav-link text-secondary" onclick="filtrarHistoricoPorAtivo('@itemTicket.ItemId', this)" type="button">
                                    <i class="bi bi-cpu-fill me-1"></i> @itemTicket.Item.Nome
                                </button>
                            </li>
                        }
                    </ul>
                }

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small" id="tabelaHistoricoIncidentes">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">@Localizer["Table_ChamadoAnterior"]</th>
                                <th scope="col">@Localizer["Table_DataAbertura"]</th>
                                <th scope="col">@Localizer["Table_SolucaoAnterior"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var hTicket in historicoIncidentes)
                            {
                                var jsonIds = System.Text.Json.JsonSerializer.Serialize(hTicket.ItemIds);
                                
                                <tr class="linha-historico" data-ativos="@jsonIds">
                                    <td class="fw-bold">
                                        <a asp-action="Details" asp-route-id="@hTicket.Id" class="text-decoration-none">
                                            #@hTicket.Id - @hTicket.Titulo
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-secondary border">@hTicket.DataAbertura</span>
                                    </td>
                                    <td class="text-secondary text-truncate" style="max-width: 250px;">
                                        @(hTicket.ParecerTecnico ?? Localizer[hTicket.StatusNome].Value)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                <!-- Mensagem de feedback caso a aba selecionada não possua históricos -->
                <p class="text-muted small mb-0 mt-3 d-none" id="msgHistoricoVazio">
                    <i class="bi bi-info-circle"></i> @Localizer["No_History_Found"]
                </p>
            }
            else
            {
                <p class="text-muted small mb-0"><i class="bi bi-shield-check"></i> @Localizer["No_History_Found"]</p>
            }
        </div>

        @if (possuiMultiplosAtivos)
        {
            <!-- Script Client-Side Eficiente para o Filtro de Linhas -->
            <script>
                function filtrarHistoricoPorAtivo(idAtivo, botaoClicado) {
                    // 1. Alterna o estado visual ativo das abas
                    document.querySelectorAll('#filtroHistoricoTabs .nav-link').forEach(btn => {
                        btn.classList.remove('active', 'fw-bold', 'text-primary');
                        btn.classList.add('text-secondary');
                    });
                    botaoClicado.classList.add('active', 'fw-bold', 'text-primary');
                    botaoClicado.classList.remove('text-secondary');

                    // 2. Filtra as linhas da tabela baseado na matriz de IDs do JSON
                    const linhas = document.querySelectorAll('#tabelaHistoricoIncidentes .linha-historico');
                    let possuiLinhasVisiveis = false;

                    linhas.forEach(linha => {
                        const idsArray = JSON.parse(linha.getAttribute('data-ativos') || '[]');
                        
                        if (idAtivo === 'todos' || idsArray.includes(parseInt(idAtivo))) {
                            linha.classList.remove('d-none');
                            possuiLinhasVisiveis = true;
                        } else {
                            linha.classList.add('d-none');
                        }
                    });

                    // 3. Gerencia a visibilidade da mensagem de feedback vazio
                    const msgVazio = document.getElementById('msgHistoricoVazio');
                    if (possuiLinhasVisiveis) {
                        msgVazio.classList.add('d-none');
                    } else {
                        msgVazio.classList.remove('d-none');
                    }
                }
            </script>
        }

        <!-- LINHA DO TEMPO (Timeline de Auditoria JSON Deserializada) -->
        <div class="card shadow-sm border rounded bg-white p-4">
            <h5 class="card-title fw-bold text-secondary mb-4">@Localizer["Details_SecaoLinhaTempo"]</h5>
            @if (logsDecodificados != null && logsDecodificados.Any())
            {
                <div class="position-relative ps-4 border-start border-2 border-light ms-2">
                    @for (int i = 0; i < logsDecodificados.Count; i++)
                    {
                        var log = logsDecodificados[i];
                        var original = auditoriasOriginais?[i];
                        bool ehComentario = log.Acao == TicketAcaoLog.Log_NovaInteracao;
                    
                        <div class="mb-4 position-relative">
                            <div class="position-absolute start-0 translate-middle rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm" 
                                style="width: 24px; height: 24px; left: -25px !important; top: 12px; bg-color: var(--bs-primary); background-color: @(ehComentario ? "#6c757d" : "#0d6efd");">
                                <i class="bi @(ehComentario ? "bi-chat-text-fill" : "bi-check-circle-fill") small"></i>
                            </div>
                            
                            <div class="p-3 bg-light rounded border border-light-subtle shadow-sm ms-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-dark">@Localizer[log.Acao.ToString()]</strong>
                                    <span class="text-muted small">
                                        <i class="bi bi-calendar3"></i> @original?.RegistradoEm.ToLocalTime().ToString("g")
                                    </span>
                                </div>
                                <div class="text-secondary small mb-2">@Localizer["Log_ExecutedBy"]: <strong>@log.Usuario</strong></div>
                                
                                @if (!string.IsNullOrEmpty(log.Mensagem))
                                {
                                    <div class="bg-white p-2 rounded border text-dark small mt-2 shadow-sm border-start border-1 border-secondary" style="white-space: pre-line;">
                                        @log.Mensagem
                                    </div>
                                }

                                @if (log.CamposModificados != null && log.CamposModificados.Any())
                                {
                                    <div class="border-top pt-2 mt-2 bg-white p-2 rounded border">
                                        @foreach (var campo in log.CamposModificados)
                                        {
                                            string valorExibicao = campo.Value;
                                            bool ehData = false;

                                            if (campo.Key == "Log_PrazoResolucaoEstendido" || campo.Key == "Log_PrazoRespostaEstendido" || 
                                                campo.Key == "Log_PrazoResposta" || campo.Key == "Log_PrazoResolucao")
                                            {
                                                if (DateTime.TryParse(campo.Value, out DateTime dataUtc))
                                                {
                                                    valorExibicao = dataUtc.ToLocalTime().ToString("g");
                                                    ehData = true;
                                                }
                                            }

                                            <div class="small text-muted py-1">
                                                <i class="bi bi-dot text-primary"></i> 
                                                <strong>@Localizer[campo.Key]:</strong> 
                                                
                                                <span class="text-dark">
                                                    @if (ehData)
                                                    {
                                                        @valorExibicao
                                                    }
                                                    else
                                                    {
                                                        @Localizer[valorExibicao]
                                                    }
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small mb-0">@Localizer["Details_SemHistorico"]</p>
            }
        </div>
        <!-- Formulário para envio de novas Interações / Comentários -->
        @if ((Model.Status.Codigo > (int)TicketStatus.Aberto && Model.Status.Codigo < (int)TicketStatus.Resolvido) &&
              ViewBag.EhTecnico)
        {
            <div class="card shadow-sm border rounded bg-white p-4 mt-4">
                <h5 class="card-title fw-bold text-secondary mb-3">@Localizer["Details_SecaoAdicionarComentario"]</h5>
                <form asp-action="AdicionarComentario" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ticketId" value="@Model.Id" />
                    
                    <div class="mb-3">
                        <textarea name="mensagemTexto" class="form-control small" rows="3" 
                                placeholder="@Localizer["Details_PlaceholderComentario"]" required style="resize: none;"></textarea>
                    </div>
                    
                    <div class="text-end">
                        <button type="submit" class="btn btn-sm btn-primary px-4 shadow-sm">
                            <i class="bi bi-send-fill me-1"></i> @Localizer["Details_BotaoEnviarComentario"]
                        </button>
                    </div>
                </form>
            </div>
        }
        else
        {
            <div class="alert alert-light border text-muted small p-3 rounded shadow-sm mt-4 text-center">
                <i class="bi bi-lock-fill text-secondary me-2"></i>
                @Localizer["Details_AvisoChamadoEncerradoComentarios"]
            </div>
        }        
    </div>

    <!-- COLUNA DA DIREITA: Painel Lateral de Metadados e Acordo de SLA -->
    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm border rounded bg-white p-4">
            <h5 class="card-title fw-bold text-secondary mb-3">@Localizer["Details_SecaoPainelControle"]</h5>
            
            <div class="mb-3 border-bottom pb-2">
                <label class="text-muted small d-block">@Localizer["Details_LabelSolicitante"]</label>
                <span class="fw-medium text-dark"><i class="bi bi-person-fill text-secondary"></i> @Model.Usuarios.Nome</span>
            </div>

            <div class="mb-3 border-bottom pb-2">
                <label class="text-muted small d-block">@Localizer["Details_LabelTecnico"]</label>
                <span class="fw-medium text-dark d-block mb-2">
                    <i class="bi bi-person-badge-fill text-secondary"></i> 
                    @(Model.UsuariosTecnicos != null ? Model.UsuariosTecnicos.Nome : Localizer["Value_Unassigned"])
                </span>
            </div>

            <div class="mb-3 border-bottom pb-2">
                <label class="text-muted small d-block mb-1">@Localizer["Details_LabelPrioridade"]</label>
                @if((Model.Status.Codigo > (int)TicketStatus.Aberto && Model.Status.Codigo < (int)TicketStatus.Resolvido) &&
                    ViewBag.EhTecnico && 
                    ViewBag.Prioridades != null &&
                    ((System.Collections.IEnumerable)ViewBag.Prioridades).Cast<object>().Any()){
                    <form asp-action="AlterarPrioridade" asp-controller="Tickets" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@Model.Id" />
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-primary border-end-0">
                                <i class="bi bi-lightning-fill"></i>
                            </span>
                            <select asp-for="PrioridadeId" class="form-select form-select-sm border-start-0 ps-0 fw-semibold"
                                asp-items="@(new SelectList(ViewBag.Prioridades, "Id", "Nome"))" OnChange="this.form.submit()">                            
                            </select>
                        </div>
                    </form>
                } else
                {
                    <span class="fw-bold text-dark d-flex align-items-center gap-1 mt-1">
                        <i class="bi bi-lightning-fill text-warning"></i> @Model.Prioridades.Nome   
                    </span>
                }
            </div>

            <div class="mb-3 border-bottom pb-2">
                <label class="text-muted small d-block">@Localizer["Details_LabelDataAbertura"]</label>
                <span class="text-secondary small">
                    <i class="bi bi-calendar-plus"></i> @Model.DataAbertura.ToLocalTime().ToString("g")
                </span>
            </div>
            
            @{
                var agoraUtc = DateTime.UtcNow;

                TimeSpan restResposta = Model.PrazoRespostaSLA - agoraUtc;
                string corSlaResp = "text-secondary border-light-subtle bg-light";
                string iconSlaResp = "bi-chat-left-dots";
                
                if (Model.UsuarioTecnicoId == null) 
                {
                    if (restResposta.TotalMinutes < 0) { corSlaResp = "text-danger border-danger-subtle bg-danger-subtle fw-bold"; iconSlaResp = "bi-exclamation-octagon-fill"; }
                    else if (restResposta.TotalDays <= 1) { corSlaResp = "text-warning border-warning-subtle bg-warning-subtle fw-bold"; iconSlaResp = "bi-exclamation-triangle-fill"; }
                }

                TimeSpan restResolucao = Model.PrazoResolucaoSLA - agoraUtc;
                string corSlaReso = "text-secondary border-light-subtle bg-light";
                string iconSlaReso = "bi-clock";
                
                if (Model.Status.Codigo < (int)TicketStatus.Resolvido)
                {
                    if (restResolucao.TotalMinutes < 0) { corSlaReso = "text-danger border-danger-subtle bg-danger-subtle fw-bold"; iconSlaReso = "bi-exclamation-octagon-fill"; }
                    else if (restResolucao.TotalDays <= 1) { corSlaReso = "text-warning border-warning-subtle bg-warning-subtle fw-bold"; iconSlaReso = "bi-exclamation-triangle-fill"; }
                }
            }
            <div class="mb-3 p-2 rounded border @corSlaResp shadow-sm">
                <label class="text-muted small d-block mb-1 fw-normal text-dark-emphasis">@Localizer["Details_LabelSlaResposta"]</label>
                <span class="small d-flex align-items-center gap-1">
                    <i class="bi @iconSlaResp"></i> @Model.PrazoRespostaSLA.ToLocalTime().ToString("g")
                </span>
            </div>

            <div class="mb-0 p-2 rounded border @corSlaReso shadow-sm">
                <label class="text-muted small d-block mb-1 fw-normal text-dark-emphasis">@Localizer["Details_LabelSlaResolucao"]</label>
                <span class="small d-flex align-items-center gap-1">
                    <i class="bi @iconSlaReso"></i> @Model.PrazoResolucaoSLA.ToLocalTime().ToString("g")
                </span>
            </div>

            
            <div class="mb-3 border-bottom pb-3">
                <label class="text-muted small d-block mb-1">@Localizer["Details_LabelStatusAtual"]</label>
                <span class="badge @classeCorStatusDetails fs-6 px-3 py-2 mb-2 d-inline-block shadow-sm">@Localizer[Model.Status.Nome]</span>

                 @switch (Model.Status.Codigo)
                {
                    case (int)TicketStatus.Aberto:
                        @if(ViewBag.EhTecnico) 
                        {  
                            @RenderizarBotaoAssumir(null) 
                            <vc:modal-message model="@modelCancelar"></vc:modal-message>
                        }
                    break;

                    case (int)TicketStatus.EmAtendimento:
                        @if(ViewBag.EhTecnico) 
                        {
                            @RenderizarBotaoPendente(null)
                            <vc:modal-message model="@modelConcluir"></vc:modal-message>
                            <vc:modal-message model="@modelCancelar"></vc:modal-message>
                        }
                    break;

                    case (int)TicketStatus.Pendente:
                        @if(ViewBag.EhTecnico) 
                        {
                            @RenderizarBotaoRetomar(null)
                        }
                    break;

                    case (int)TicketStatus.Resolvido: 
                        @RenderizarLinkAbrirNovo(null)                  
                    break;

                    case (int)TicketStatus.Fechado:
                        @RenderizarLinkAbrirNovo(null)
                    break;

                    case (int)TicketStatus.Cancelado:
                    break;                                                                                                    
                }
            </div>            
        </div>
    </div>
</div>
