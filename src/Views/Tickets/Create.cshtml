@model ChamadosTi.ViewModels.Ticket.TicketCreateViewModel
@{ ViewData["Title"] = Localizer["Tickets_Create_Title"]; }

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6">
        <div class="border rounded p-4 shadow-sm bg-white">
            <h2 class="h3 mb-3 fw-normal text-center">@ViewData["Title"]</h2>
            <p class="text-muted small text-center mb-4">@Localizer["Tickets_Create_Instructions"]</p>

            <form asp-controller="Tickets" asp-action="Create" method="post">
                @Html.AntiForgeryToken()                
                <input type="hidden" name="origemId" value="@ViewBag.OrigemId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Titulo" class="form-control" placeholder="Título" aria-required="true" />
                    <label asp-for="Titulo">@Localizer["Label_Titulo"]</label>
                    <span asp-validation-for="Titulo" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoriaId" class="form-label text-muted small px-2">@Localizer["Label_Categoria"]</label>
                    <select asp-for="CategoriaId" class="form-select" asp-items="@(new SelectList(ViewBag.Categorias, "Id", "Nome"))">
                        <option value="">@Localizer["Select_Categoria_Placeholder"]</option>
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ItensIdsSelecionados" class="form-label text-muted small px-2">@Localizer["Label_ItensAfetados"]</label>
                    
                    @if (ViewBag.Itens != null && ((System.Collections.IEnumerable)ViewBag.Itens).Cast<object>().Any())
                    {
                        <select asp-for="ItensIdsSelecionados" class="form-select" multiple style="height: 120px;"
                                asp-items="@(new SelectList(ViewBag.Itens, "Id", "Texto"))">
                        </select>
                        <div class="form-text small text-muted px-2">@Localizer["HelpText_MultipleSelection"]</div>
                    }
                    else
                    {
                        <div class="alert alert-light border text-muted small p-3 rounded shadow-sm mb-0">
                            <i class="bi bi-info-circle-fill text-secondary me-2"></i>
                            @Localizer["Message_NoAssetsInSector"]
                        </div>
                    }
                </div>

                <div class="form-floating mb-4">
                    <textarea asp-for="Comentario" class="form-control" placeholder="Descrição" style="height: 150px;"></textarea>
                    <label asp-for="Comentario">@Localizer["Label_Comentario"]</label>
                    <span asp-validation-for="Comentario" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">@Localizer["Button_OpenTicket"]</button>
                    <a asp-controller="Tickets" asp-action="Index" class="btn btn-outline-secondary w-100">@Localizer["Button_Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { 
    <partial name="_ValidationScriptsPartial" /> 
}
