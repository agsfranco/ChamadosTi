@model ChamadosTi.ViewModels.Account.ForgotPasswordViewModel
@{ ViewData["Title"] = Localizer["ForgotPassword_Title"]; }
<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="border rounded p-4 shadow-sm bg-white">
            <h2 class="h3 mb-3 fw-normal text-center">@ViewData["Title"]</h2>
            <p class="text-muted small text-center mb-4">@Localizer["ForgotPassword_Instructions"]</p>
            <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <div class="form-floating mb-4">
                    <input asp-for="Email" class="form-control" autocomplete="username" placeholder="name@example.com" aria-required="true" />
                    <label asp-for="Email">@Localizer["Email"]</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary mb-2">@Localizer["Button_Submit"]</button>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
