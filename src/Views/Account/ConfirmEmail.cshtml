@{ ViewData["Title"] = Localizer["Title"]; }

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center bg-white border rounded p-4 shadow-sm">
        <h2>@ViewData["Title"]</h2>
        <p class="mt-3 text-success fw-semibold">@ViewBag.StatusMessage</p>
        <a class="btn btn-primary mt-3" asp-controller="Account" asp-action="Login">@Localizer["Button_Login"]</a>
    </div>
</div>

