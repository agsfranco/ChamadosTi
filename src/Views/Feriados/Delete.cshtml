@model ChamadosTi.Models.Feriado
@{ ViewData["Title"] = Localizer["Feriados_Delete_Title"]; }

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="border rounded p-4 shadow-sm bg-white text-center">
            <h2 class="h3 text-danger mb-3">@ViewData["Title"]</h2>
            <p class="mb-4">@Localizer["Delete_Confirmation_Message"] <strong>@Model.Nome (@Model.Dia.ToString("d"))</strong>?</p>
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger w-100">@Localizer["Button_ConfirmDelete"]</button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">@Localizer["Button_Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
</div>
