 *@
<!DOCTYPE html>
<html lang="@System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        @if (ViewData["Title"] is not null) { 
            @:@(Localizer["Title"]) - @(ViewData["Title"])
        } else {
            @Localizer["Title"]
        }
    </title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg">
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light text-dark">
    @{
        IHtmlContent RenderizarItemMenu(string controller, string action, string icone, string chaveLocalizer)
        {
            var url = Url.Action(action, controller);
            var textoTraduzido = Localizer[chaveLocalizer].Value;

            var html = $@"
                <li class='nav-item'>
                    <a class='nav-link text-dark fw-medium small d-flex align-items-center gap-1' 
                    href='{url}'>
                        <i class='bi {icone} text-muted'></i>{textoTraduzido}
                    </a>
                </li>";
                
            return new Microsoft.AspNetCore.Html.HtmlString(html);
        }

        IHtmlContent RenderizarItemDropdown(string controller, string action, string icone, string chaveLocalizer)
        {
            var url = Url.Action(action, controller);
            var textoTraduzido = Localizer[chaveLocalizer].Value;

            var html = $@"
                <li>
                    <a class='dropdown-item small fw-medium d-flex align-items-center gap-2' href='{url}'>
                        <i class='bi {icone} text-muted' style='font-size: 0.9rem;'></i>{textoTraduzido}
                    </a>
                </li>";

            return new Microsoft.AspNetCore.Html.HtmlString(html);
        }
    }
    <header>
        <nav class="navbar navbar-expand-md navbar-light bg-white border-bottom mb-3 shadow-sm py-2">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-1" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-cpu-fill"></i> @Localizer["Title"]
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-md-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0 ms-2">
                        @RenderizarItemMenu("Home", "Index", "bi-house-door-fill", "Navbar_Menu1")
                        @RenderizarItemMenu("Tickets", "Index", "bi-ticket-perforated-fill", "Navbar_Menu2")
                        
                        @if (UsuarioService.EhTecnico(User))
                        {
                            @RenderizarItemMenu("Itens", "Index", "bi-hdd-rack-fill", "Navbar_Menu3")                            
                            @RenderizarItemMenu("Sla", "Dashboard", "bi-bar-chart-line-fill", "Navbar_MenuSla")                            
                        }
                        
                        @if (UsuarioService.EhAdmin(User))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-medium small d-flex align-items-center gap-1" 
                                   href="#" id="navbarDropdownAdmin" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear-fill text-muted"></i> @Localizer["Menu_Administracao"]
                                </a>
                                <ul class="dropdown-menu shadow-sm" aria-labelledby="navbarDropdownAdmin">
                                    @RenderizarItemDropdown("Usuarios", "Index", "bi-people-fill", "Navbar_Menu4")
                                    @RenderizarItemDropdown("Setores", "Index", "bi-diagram-3-fill", "Menu_GerenciarSetores")
                                    <li><hr class="dropdown-divider"></li>
                                    @RenderizarItemDropdown("Prioridades", "Index", "bi-sliders", "Menu_ParametrosSla")
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-4">
                        <partial name="_SelectLanguagePartial" />
                        <div class="border-start h-25 bg-secondary opacity-25" style="width: 1px; min-height: 24px;"></div>
                        <vc:menu-usuario  controller="Account" action-login="Login" action-logout="logout" action-register="Register" action-complete-profile="CompleteProfile" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="d-flex justify-content-between align-items-center p-3 bg-white border-top mt-auto small">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center w-100">
            <div>
                <span class="text-muted">&copy; @DateTime.UtcNow.Year - @Localizer["Span_Copyright"]</span>
            </div>
            <div>
                <span class="text-muted fw-light text-end">@Localizer["Span_Empresa"]</span>
            </div>
        </div>
    </footer>

    <environment include="Development">
        <script src="~/lib/jquery/jquery.js"></script>
        <script src="~/lib/bootstrap/js/bootstrap.bundle.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery/jquery.min.js"></script>
        <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    </environment>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

