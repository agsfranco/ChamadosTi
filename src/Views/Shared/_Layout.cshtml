<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Localizer["Title"]</title>
    <link rel="icon" type="image/png" href="~/favicon.png">
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom mb-3 shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-dark" asp-controller="Home" asp-action="Index">
                    @Localizer["Title"]
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-sm-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">@Localizer["Navbar_Menu1"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">@Localizer["Navbar_Menu2"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">@Localizer["Navbar_Menu3"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">@Localizer["Navbar_Menu4"]</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <!-- Chama a partial de login aqui -->
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            <!-- Linha crucial restaurada aqui -->
            @RenderBody()
        </main>
    </div>

    <footer class="d-flex justify-content-between align-items-center p-3 bg-light border-top mt-auto">
        <div>
            <span class="text-muted">@Localizer["Span_Copyright"]</span>
        </div>
        <div>
            <ul class="nav">
                <li class="nav-item">
                    <span class="nav-link link-dark px-2">
                        <partial name="_SelectLanguagePartial" />
                    </span>
                </li>
            </ul>
        </div>
    </footer>

    <environment include="Development">
        <script src="~/lib/jquery/jquery.js"></script>
        <script src="~/lib/bootstrap/js/bootstrap.bundle.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery/jquery.min.js"></script>
        <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    </environment>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
