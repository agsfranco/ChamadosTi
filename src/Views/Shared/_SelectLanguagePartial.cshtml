@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var cultureItems = LocOptions?.Value?.SupportedUICultures?
        .Select(c => new SelectListItem { Value = c.Name, Text = c.DisplayName.ToLower() })
        .ToList();
    var returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/" : $"~{Context.Request.Path.Value}";
    var requestCultureName = @requestCulture?.RequestCulture.UICulture.Name ?? "en-US";
}

<div title="@Localizer["Div_Select"]">
    <form id="selectLanguage" asp-controller="Home" asp-action="SetLanguage" asp-route-returnUrl="@returnUrl" 
          method="post" class="d-flex align-items-center gap-2" role="form">
        
        <!-- Texto explicativo discreto (opcional) -->
        <span class="text-muted small">@Localizer["Span_Idioma"]</span>
        
        <!-- Select customizado e compacto do Bootstrap 5 -->
        <select name="culture" onchange="this.form.submit();"
                asp-for="@requestCultureName" 
                asp-items="cultureItems"
                class="form-select form-select-sm text-dark bg-white shadow-sm"
                style="max-width: 200px; cursor: pointer;">
        </select>
    </form>
</div>
