@model ChamadosTi.ViewModels.Components.ModalMessage.ModalMessageViewModel
@inject IViewLocalizer Localizer;

@if (Model.BotaoAbrirHabilitado == true)
{
    <div class="mt-3 pt-2 border-top">
        <button type="button" class="@Model.BotaoAbrirClass" 
                data-bs-toggle="modal" data-bs-target="#@Model.ModalId">
            <i class="@Model.BotaoAbrirIcone"></i> @Localizer[@Model.BotaoAbrirTexto ?? ""] 
        </button>
    </div>
} else
{
    <script>
        window.addEventListener('load', function () {
            var elementoModal = document.getElementById('@Model.ModalId');
            if (elementoModal) {
                var meuModal = new bootstrap.Modal(elementoModal);
                meuModal.show();
            }
        });
    </script>
}

<div class="modal fade" id="@Model.ModalId" data-bs-backdrop="static" tabindex="-1" aria-labelledby="@($"{Model.ModalId}-Title")" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header @Model.CorFundo text-white py-3">
                <h5 class="modal-title fw-bold small" id="@($"{Model.ModalId}-Title")">
                    <i class="bi @Model.Icone me-2"></i>@Localizer[Model.Titulo]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @if(!string.IsNullOrWhiteSpace(@Model.Action))
            {
                <form asp-action="@Model.Action" asp-route-id="@Model.RouteId" method="@Model.Method">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <p class="text-muted small mb-3">@Model.Mensagem</p>
                        
                        <div class="mb-0">
                            <label class="text-muted small fw-medium mb-1">@Localizer["LabelJustificativa"]</label>
                            <textarea name="justificativaTexto" class="form-control small" rows="3" placeholder="@Localizer["PlaceholderJustificativa"]" required style="resize: none;"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light p-3 border-top d-flex gap-2">
                        <button type="@Model.BotaoConfirmarType" class="@Model.BotaoConfirmarClass">
                            <i class="@Model.BotaoConfirmarIcone"></i>
                            @Localizer[Model.BotaoConfirmarTexto]
                        </button>
                        @if(@Model.Botao != TipoBotaoModal.Ok)
                        {
                            <button type="@Model.BotaoConfirmarType" class="@Model.BotaoCancelarClass" data-bs-dismiss="modal">
                                <i class="@Model.BotaoCancelarIcone"></i>
                                @Localizer[Model.BotaoCancelarTexto]
                            </button>                        
                        }
                    </div>
                </form>
            } else {
                <div class="modal-body p-4">
                    <p class="text-muted small mb-0">@Model.Mensagem</p>
                </div>
                <div class="modal-footer bg-light p-3 border-top d-flex gap-2">
                    <button type="@Model.BotaoConfirmarType" class="@Model.BotaoConfirmarClass" data-bs-dismiss="modal">
                        <i class="@Model.BotaoConfirmarIcone"></i>
                        @Localizer[Model.BotaoConfirmarTexto]
                    </button>
                </div>
            }
        </div>
    </div>
</div>